<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Usciamo? – Organizza con gli amici</title>
<style>
/* ===== Temi: colori come variabili ===== */
:root{--bg:#fff6ec;--card:#ffffff;--ink:#3b2a20;--mut:#8b7567;--acc:#e8693a;--accs:#ffe9db;--free:#4fae62;--busy:#e5584f;--line:#f1e0d0;--past:#e8dfd7;--today:#f6b73c;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1f1814;--card:#2a211b;--ink:#f5e9df;--mut:#b3a093;--acc:#ff8a5c;--accs:#44291c;--free:#5cc271;--busy:#ee6a60;--line:#3d3029;--past:#3a322d;--today:#f6b73c;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#1f1814;--card:#2a211b;--ink:#f5e9df;--mut:#b3a093;--acc:#ff8a5c;--accs:#44291c;--free:#5cc271;--busy:#ee6a60;--line:#3d3029;--past:#3a322d;--today:#f6b73c;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
main{max-width:640px;margin:0 auto;padding:16px 14px 60px}
header{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
h1{font-size:1.5rem;margin:0}h2{font-size:1.1rem;margin:0 0 10px}
.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:16px;margin-bottom:14px;box-shadow:0 4px 14px rgba(120,70,30,.06)}
label{display:block;font-weight:600;font-size:.9rem;margin:10px 0 4px}
input,textarea{width:100%;padding:14px;border:1.5px solid var(--line);border-radius:14px;background:var(--bg);color:var(--ink);font:inherit}
input:focus,textarea:focus{outline:2px solid var(--acc);border-color:transparent}
button{font:inherit;cursor:pointer;border:0;border-radius:14px;padding:13px 16px;min-height:48px;font-weight:600;background:var(--accs);color:var(--ink)}
button.p{background:var(--acc);color:#fff}
button.g{background:#25a65a;color:#fff}
.row{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.row>button{flex:1 1 140px}
.mut{color:var(--mut);font-size:.88rem}
.legend{display:flex;gap:14px;font-size:.85rem;margin:6px 0}
.dot{display:inline-block;width:12px;height:12px;border-radius:4px;vertical-align:-1px;margin-right:4px}
/* ===== Griglia settimanale ===== */
.grid{display:grid;grid-template-columns:34px repeat(7,1fr);gap:3px;touch-action:none;user-select:none;-webkit-user-select:none;margin-top:8px}
.dh{border-radius:10px;text-align:center;padding:4px 0;font-size:.75rem;background:var(--accs);cursor:pointer;line-height:1.2}
.dh b{display:block;font-size:1rem}
.dh.sel{outline:2px solid var(--acc)}
.dh.today{background:var(--today);color:#3b2a20}
.hl{font-size:.68rem;color:var(--mut);display:flex;align-items:center;justify-content:flex-end;padding-right:3px}
.c{height:38px;border-radius:8px;background:var(--free)}
.c.busy{background:var(--busy)}
.c.past{background:var(--past);opacity:.7;cursor:not-allowed}
.c.tc{box-shadow:inset 0 0 0 2px var(--today)}
/* ===== Invitato ===== */
.day{margin:12px 0}.day h3{font-size:1rem;margin:0 0 6px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{background:var(--accs);border:2px solid transparent;min-width:92px}
.chip.on{background:var(--free);color:#fff}
.best{border:2px solid var(--today);background:var(--accs);border-radius:14px;padding:10px 12px;margin:8px 0}
.link{font-size:.8rem;word-break:break-all}
#toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:99px;opacity:0;transition:opacity .25s;pointer-events:none}
#toast.on{opacity:1}
[hidden]{display:none!important}
</style>
</head>
<body>
<main>
<header><h1>🍻 Usciamo?</h1><button id="theme" aria-label="Cambia tema">🌓</button></header>

<!-- ================= VISTA ORGANIZZATORE ================= -->
<section id="org">
  <div class="card">
    <h2>Evento</h2>
    <label for="t">Titolo</label><input id="t" placeholder="es. Cena fuori" maxlength="60">
    <label for="n">Note o luogo (facoltativo)</label><input id="n" placeholder="es. Pizzeria da Gino, zona Navigli" maxlength="100">
  </div>

  <div class="card">
    <h2>I miei impegni</h2>
    <p class="mut">Tocca o trascina sulle celle per alternare. Tocca un giorno per sceglierlo prima di copiarlo.</p>
    <div class="legend"><span><i class="dot" style="background:var(--free)"></i>Libero</span><span><i class="dot" style="background:var(--busy)"></i>Impegnato</span><span><i class="dot" style="background:var(--today)"></i>Oggi</span></div>
    <div class="row" style="margin-top:0"><button id="w0">Questa settimana</button><button id="w1">Prossima settimana</button></div>
    <div class="grid" id="grid"></div>
    <div class="row">
      <button id="allF">Segna tutto come libero</button>
      <button id="allB">Segna tutto come impegnato</button>
      <button id="cp">Copia questo giorno sugli altri</button>
    </div>
  </div>

  <div class="card">
    <button class="p" id="gen" style="width:100%">Genera link</button>
    <div id="out" hidden>
      <label>Link da condividere</label>
      <input id="lnk" class="link" readonly>
      <div class="row"><button id="cpl">Copia link</button><button class="g" id="wal">Condividi su WhatsApp</button></div>
    </div>
  </div>

  <div class="card">
    <h2>Risposte degli amici</h2>
    <p class="mut">Incolla qui i messaggi ricevuti (anche tutti insieme): evidenzio lo slot con più preferenze.</p>
    <textarea id="resp" rows="4" placeholder="Incolla le risposte…"></textarea>
    <div id="res"></div>
  </div>
</section>

<!-- ================= VISTA INVITATO ================= -->
<section id="guest" hidden>
  <div class="card">
    <h2 id="gt"></h2><p class="mut" id="gn"></p>
    <label for="gname">Il tuo nome</label><input id="gname" placeholder="Come ti chiami?" maxlength="30">
  </div>
  <div class="card">
    <h2>Quando sei libero?</h2>
    <p class="mut">Tocca gli orari in cui ti va bene.</p>
    <div id="slots"></div>
    <div class="row"><button class="g" id="gwa">Invia disponibilità su WhatsApp</button><button id="gcp">Copia messaggio</button></div>
  </div>
  <p class="mut" style="text-align:center"><a href="#" id="new" style="color:var(--acc)">Organizza il tuo evento</a></p>
</section>
</main>
<div id="toast"></div>

<script>
"use strict";
/* ===== Costanti e utilità ===== */
const GG=["Lun","Mar","Mer","Gio","Ven","Sab","Dom"], H0=8, NH=16, N=7*NH;
const $=s=>document.querySelector(s), pad=n=>String(n).padStart(2,"0");
const esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const iso=d=>d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate());
const fromIso=s=>{const[a,b,c]=s.split("-").map(Number);return new Date(a,b-1,c)};
function monday(off){const d=new Date();d.setHours(0,0,0,0);d.setDate(d.getDate()-((d.getDay()+6)%7)+off*7);return d}
function slotStart(w,d,h){const x=new Date(w);x.setDate(x.getDate()+d);x.setHours(H0+h);return x}
const isPast=(w,d,h)=>slotStart(w,d,h).getTime()+3600000<Date.now();
const lab=h=>pad(H0+h)+":00–"+pad(H0+h+1)+":00";
const dayLab=(w,d)=>{const x=slotStart(w,d,0);return GG[d]+" "+pad(x.getDate())+"/"+pad(x.getMonth()+1)};
// Maschera slot (112 bit) <-> stringa esadecimale (28 caratteri)
const toHex=m=>{let s="";for(let i=0;i<N;i+=4)s+=(m[i]*8+m[i+1]*4+m[i+2]*2+m[i+3]).toString(16);return s};
const fromHex=s=>{const m=[];for(const c of s){const v=parseInt(c,16);m.push(v>>3&1,v>>2&1,v>>1&1,v&1)}return m};
// Codifica/decodifica base64url (UTF-8 sicuro) per il link
const enc=o=>btoa(unescape(encodeURIComponent(JSON.stringify(o)))).replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/,"");
const dec=t=>JSON.parse(decodeURIComponent(escape(atob(t.replace(/-/g,"+").replace(/_/g,"/")))));
function toast(t){const e=$("#toast");e.textContent=t;e.classList.add("on");setTimeout(()=>e.classList.remove("on"),1800)}
async function copy(t){try{await navigator.clipboard.writeText(t)}catch(e){const a=document.createElement("textarea");a.value=t;document.body.appendChild(a);a.select();try{document.execCommand("copy")}catch(_){}a.remove()}toast("Copiato!")}
const wa=t=>window.open("https://wa.me/?text="+encodeURIComponent(t),"_blank");

/* ===== Tema chiaro/scuro ===== */
$("#theme").onclick=()=>{const dark=document.documentElement.dataset.theme==="dark"||(!document.documentElement.dataset.theme&&matchMedia("(prefers-color-scheme:dark)").matches);document.documentElement.dataset.theme=dark?"light":"dark";try{localStorage.setItem("uscite-tema",document.documentElement.dataset.theme)}catch(e){}};
try{const t=localStorage.getItem("uscite-tema");if(t)document.documentElement.dataset.theme=t}catch(e){}

/* ===== Stato organizzatore (bozza salvata nel browser) ===== */
let S={t:"",n:"",off:0,sel:0,m:Array(N).fill(1),resp:""};
try{const b=JSON.parse(localStorage.getItem("uscite-bozza")||"null");if(b&&b.m&&b.m.length===N)S=Object.assign(S,b)}catch(e){}
const save=()=>{try{localStorage.setItem("uscite-bozza",JSON.stringify(S))}catch(e){}};
const W=()=>monday(S.off);

function buildGrid(){
  const g=$("#grid"),w=W(),td=iso(new Date());let h='<div></div>';
  for(let d=0;d<7;d++){const x=slotStart(w,d,0);h+=`<div class="dh${iso(x)===td?" today":""}${S.sel===d?" sel":""}" data-d="${d}">${GG[d]}<b>${x.getDate()}</b></div>`}
  for(let r=0;r<NH;r++){h+=`<div class="hl">${H0+r}</div>`;
    for(let d=0;d<7;d++){const i=d*NH+r,p=isPast(w,d,r);h+=`<div class="c${S.m[i]?"":" busy"}${p?" past":""}" data-i="${i}"></div>`}}
  g.innerHTML=h;
}
function paintCells(){document.querySelectorAll(".c").forEach(c=>c.classList.toggle("busy",!S.m[+c.dataset.i]))}

/* Click o trascinamento sulle celle */
let paintVal=null;
const cellAt=e=>{const el=document.elementFromPoint(e.clientX,e.clientY);return el&&el.closest(".c:not(.past)")};
function paint(c){if(!c)return;const i=+c.dataset.i;if(S.m[i]!==paintVal){S.m[i]=paintVal;c.classList.toggle("busy",!paintVal)}}
$("#grid").addEventListener("pointerdown",e=>{
  const dh=e.target.closest(".dh");
  if(dh){S.sel=+dh.dataset.d;document.querySelectorAll(".dh").forEach(x=>x.classList.toggle("sel",+x.dataset.d===S.sel));save();return}
  const c=cellAt(e);if(!c)return;paintVal=1-S.m[+c.dataset.i];paint(c);
});
$("#grid").addEventListener("pointermove",e=>{if(paintVal!==null)paint(cellAt(e))});
addEventListener("pointerup",()=>{if(paintVal!==null){paintVal=null;save()}});
addEventListener("pointercancel",()=>{paintVal=null});

/* Pulsanti rapidi */
const setAll=v=>{const w=W();for(let d=0;d<7;d++)for(let h=0;h<NH;h++)if(!isPast(w,d,h))S.m[d*NH+h]=v;paintCells();save()};
$("#allF").onclick=()=>setAll(1);
$("#allB").onclick=()=>setAll(0);
$("#cp").onclick=()=>{const w=W();for(let d=0;d<7;d++)if(d!==S.sel)for(let h=0;h<NH;h++)if(!isPast(w,d,h))S.m[d*NH+h]=S.m[S.sel*NH+h];paintCells();save();toast("Giorno copiato")};
[0,1].forEach(o=>$("#w"+o).onclick=()=>{S.off=o;save();buildGrid();markWeek()});
function markWeek(){$("#w0").classList.toggle("p",S.off===0);$("#w1").classList.toggle("p",S.off===1)}

/* Titolo e note */
$("#t").value=S.t;$("#n").value=S.n;$("#resp").value=S.resp;
$("#t").oninput=e=>{S.t=e.target.value;save()};
$("#n").oninput=e=>{S.n=e.target.value;save()};

/* Generazione link: gli slot liberi (non passati) finiscono nell'URL */
let shareUrl="";
$("#gen").onclick=()=>{
  const w=W(),m=S.m.map((v,i)=>v&&!isPast(w,Math.floor(i/NH),i%NH)?1:0);
  if(!m.includes(1))return toast("Nessuno slot libero da condividere");
  const t=S.t.trim()||"Uscita tra amici";
  shareUrl=location.href.split("#")[0]+"#"+enc({t,n:S.n.trim(),w:iso(w),m:toHex(m)});
  $("#lnk").value=shareUrl;$("#out").hidden=false;
};
$("#cpl").onclick=()=>copy(shareUrl);
$("#wal").onclick=()=>wa("Ciao! Sto organizzando «"+(S.t.trim()||"un’uscita")+"» 🍻 Dimmi quando ti va bene da qui:\n"+shareUrl);

/* Raccolta risposte: cerca i codici [DISP:nome|settimana|maschera] nei messaggi incollati */
function showResults(){
  S.resp=$("#resp").value;save();
  const r=new Map(),re=/\[DISP:([^|\]]*)\|(\d{4}-\d\d-\d\d)\|([0-9a-f]{28})\]/g;let x;
  while((x=re.exec(S.resp)))r.set(x[1]+"|"+x[2],{name:x[1]||"?",w:x[2],m:fromHex(x[3])});
  const tally={};
  r.forEach(a=>a.m.forEach((v,i)=>{if(v){const k=a.w+"#"+i;(tally[k]=tally[k]||[]).push(a.name)}}));
  const list=Object.entries(tally).sort((a,b)=>b[1].length-a[1].length).slice(0,6);
  if(!r.size){$("#res").innerHTML="";return}
  let h=`<p class="mut">${r.size} ${r.size===1?"risposta":"risposte"} ricevut${r.size===1?"a":"e"}</p>`;
  list.forEach(([k,names],j)=>{const[w,i]=k.split("#"),d=Math.floor(i/NH),hh=i%NH;
    h+=`<div class="${j===0?"best":""}" ${j?'style="padding:6px 12px"':""}>${j===0?"⭐ <b>Il migliore:</b> ":""}<b>${dayLab(fromIso(w),d)}</b>, ${lab(hh)} – ${names.length}/${r.size}<br><span class="mut">${names.map(esc).join(", ")}</span></div>`});
  $("#res").innerHTML=h;
}
$("#resp").oninput=showResults;

/* ===== Vista invitato ===== */
function initGuest(data){
  $("#org").hidden=true;$("#guest").hidden=false;
  $("#gt").textContent=data.t;$("#gn").textContent=data.n||"";
  const w=fromIso(data.w),free=fromHex(data.m),sel=new Set();let h="";
  for(let d=0;d<7;d++){let c="";
    for(let r=0;r<NH;r++){const i=d*NH+r;if(free[i]&&!isPast(w,d,r))c+=`<button class="chip" data-i="${i}">${lab(r)}</button>`}
    if(c)h+=`<div class="day"><h3>${dayLab(w,d)}</h3><div class="chips">${c}</div></div>`}
  $("#slots").innerHTML=h||'<p class="mut">Nessuno slot disponibile: l’organizzatore dovrà inviare un nuovo link.</p>';
  $("#slots").onclick=e=>{const b=e.target.closest(".chip");if(!b)return;const i=+b.dataset.i;sel.has(i)?sel.delete(i):sel.add(i);b.classList.toggle("on",sel.has(i))};
  try{$("#gname").value=localStorage.getItem("uscite-nome")||""}catch(e){}
  const msg=()=>{
    const name=$("#gname").value.trim().replace(/[|\][]/g,"");
    if(!name){toast("Inserisci il tuo nome");return null}
    if(!sel.size){toast("Scegli almeno uno slot");return null}
    try{localStorage.setItem("uscite-nome",name)}catch(e){}
    const m=Array(N).fill(0);let lines="";
    for(let d=0;d<7;d++){const hs=[];for(let r=0;r<NH;r++)if(sel.has(d*NH+r)){m[d*NH+r]=1;hs.push(pad(H0+r)+":00")}
      if(hs.length)lines+=dayLab(w,d)+": "+hs.join(", ")+"\n"}
    return "Ciao! Sono "+name+", ecco quando posso per «"+data.t+"» 🍻\n"+lines+"\n[DISP:"+name+"|"+data.w+"|"+toHex(m)+"]";
  };
  $("#gwa").onclick=()=>{const t=msg();if(t)wa(t)};
  $("#gcp").onclick=()=>{const t=msg();if(t)copy(t)};
}
$("#new").onclick=e=>{e.preventDefault();location.hash="";location.reload()};

/* ===== Avvio: se c'è un codice nell'URL → vista invitato ===== */
function start(){
  const t=location.hash.slice(1);
  if(t){try{const d=dec(t);if(d&&d.m&&d.w)return initGuest(d)}catch(e){}}
  $("#org").hidden=false;$("#guest").hidden=true;buildGrid();markWeek();showResults();
}
addEventListener("hashchange",()=>location.reload());
start();
</script>
</body>
</html>
